{
  "manifest_version": 3,
  "name": "CommitForce",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Contest-safe, automated Codeforces solution sync to GitHub with dynamic streak tracking and encrypted vault.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Codeforces Sync",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "identity"
  ],
  "optional_host_permissions": [
    "https://cfgh-auth.kartikeyaaryam7.workers.dev/*"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://api.github.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "key": ""
}
