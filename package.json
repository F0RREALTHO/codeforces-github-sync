{
  "name": "codeforces-github-sync",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:edge": "tsc -b && node scripts/build-edge.mjs",
    "build:firefox": "tsc -b && node scripts/build-firefox.mjs",
    "build:test": "tsc -b && vite build --mode test --outDir dist-test && node scripts/prepare-test-dist.mjs",
    "test": "vitest run && vitest run --config backend/vitest.config.ts",
    "test:extension": "vitest run",
    "test:backend": "vitest run --config backend/vitest.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
